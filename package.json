{
  "name": "conduit",
  "version": "0.0.1",
  "private": true,
  "description": "Deterministic trust and enforcement for agentic commerce",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:check": "dotenv -e .env -- pnpm --filter @conduit/infrastructure exec node scripts/check-test-database.mjs",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "dotenv -e .env -- pnpm --filter @conduit/infrastructure db:migrate",
    "db:rollback": "dotenv -e .env -- pnpm --filter @conduit/infrastructure db:rollback",
    "db:setup": "pnpm db:up && pnpm db:check",
    "db:shell": "docker compose exec postgres psql -U conduit -d conduit",
    "db:up": "docker compose up -d --wait postgres",
    "demo:commerce": "dotenv -e .env -- pnpm --filter @conduit/walking-skeleton demo",
    "demo:web": "dotenv -e .env -- pnpm --filter @conduit/trust-demo start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "pnpm db:check",
    "test:integration:raw": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "dotenv-cli": "11.0.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
