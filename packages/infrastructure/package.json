{
  "name": "@conduit/infrastructure",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "node-pg-migrate up --migrations-dir ../../db/migrations --migrations-table schema_migrations --database-url-var DATABASE_URL",
    "db:rollback": "node-pg-migrate down --migrations-dir ../../db/migrations --migrations-table schema_migrations --database-url-var DATABASE_URL",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@conduit/application": "workspace:*",
    "@conduit/domain": "workspace:*",
    "@conduit/enforcement": "workspace:*",
    "@conduit/observability": "workspace:*",
    "@conduit/onboarding": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@conduit/contracts": "workspace:*",
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0"
  }
}
