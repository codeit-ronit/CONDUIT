# Local development only. Production credentials must come from a secret manager.
POSTGRES_DB=conduit
POSTGRES_USER=conduit
POSTGRES_PASSWORD=conduit_local_only
POSTGRES_PORT=54329
DATABASE_URL=postgresql://conduit:conduit_local_only@127.0.0.1:54329/conduit

# Optional when the demo is exposed through a stable public origin.
# Local HTTP is for development and is not a UCP-conformant public deployment.
# PUBLIC_BASE_URL=https://commerce.example.com

# Optional local merchant-console override. The built-in localhost credential is
# published in the demo UI; any override is never returned by the API.
# DEMO_MERCHANT_PASSWORD=

# Optional Phase 4 live-model demo. Keep real values only in .env (gitignored).
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
